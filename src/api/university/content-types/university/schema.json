{
  "kind": "collectionType",
  "collectionName": "universities",
  "info": {
    "singularName": "university",
    "pluralName": "universities",
    "displayName": "University",
    "description": "University information and details"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "universityCode": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "contactNumber": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "United States"
    },
    "zipCode": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "establishedYear": {
      "type": "integer",
      "min": 1600,
      "max": 2030
    },
    "coursesOffered": {
      "type": "json",
      "default": []
    },
    "departments": {
      "type": "json",
      "default": []
    },
    "accreditation": {
      "type": "string"
    },
    "studentCapacity": {
      "type": "integer",
      "min": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "richtext"
    },
    "admins": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "university"
    },
    "students": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::student.student",
      "mappedBy": "university"
    }
  }
}
