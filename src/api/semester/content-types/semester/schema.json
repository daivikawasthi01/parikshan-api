{
  "kind": "collectionType",
  "collectionName": "semesters",
  "info": {
    "singularName": "semester",
    "pluralName": "semesters",
    "displayName": "Semester",
    "description": "Student semester records with academic performance"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "semesterNumber": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 12
    },
    "academicYear": {
      "type": "string",
      "required": true
    },
    "GPA": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "totalCredits": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "isCurrentSemester": {
      "type": "boolean",
      "default": false
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::student.student",
      "inversedBy": "semesters"
    },
    "courses": {
      "type": "json",
      "default": []
    }
  }
}
