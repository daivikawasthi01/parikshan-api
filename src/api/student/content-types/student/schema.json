{
  "kind": "collectionType",
  "collectionName": "students",
  "info": {
    "singularName": "student",
    "pluralName": "students",
    "displayName": "Student",
    "description": "Student profiles and academic information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "studentId": {
      "type": "uid",
      "targetField": "users_permissions_user",
      "required": true
    },
    "department": {
      "type": "string"
    },
    "enrollmentDate": {
      "type": "date"
    },
    "expectedGraduation": {
      "type": "date"
    },
    "phoneNumber": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "student"
    },
    "university": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::university.university",
      "inversedBy": "students"
    },
    "semesters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::semester.semester",
      "mappedBy": "student"
    }
  }
}
