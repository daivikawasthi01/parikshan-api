{
  "kind": "collectionType",
  "collectionName": "students",
  "info": {
    "singularName": "student",
    "pluralName": "students",
    "displayName": "Student",
    "description": "Student profiles and academic information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "studentId": {
      "type": "uid",
      "targetField": "users_permissions_user",
      "required": true
    },
    "CGPA": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "semester": {
      "type": "integer",
      "min": 1,
      "max": 12
    },
    "year": {
      "type": "enumeration",
      "enum": ["Freshman", "Sophomore", "Junior", "Senior", "Graduate"],
      "default": "Freshman"
    },
    "department": {
      "type": "string"
    },
    "enrollmentDate": {
      "type": "date"
    },
    "expectedGraduation": {
      "type": "date"
    },
    "status": {
      "type": "enumeration",
      "enum": ["Active", "Inactive", "Suspended", "Graduated", "Dropped"],
      "default": "Active"
    },
    "phoneNumber": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "student"
    },
    "university": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::university.university",
      "inversedBy": "students"
    }
  }
}
